# ---------------------------------------------------------------------------
# RoadScan .gitignore
#
# This repo is PRIVATE and, by explicit choice, commits its environment/config
# files (supabase.json) rather than ignoring them. See SECURITY note in
# README.md -- if this repo is ever made public or shared, the Supabase key
# must be rotated first.
#
# What stays ignored below is only the stuff that is genuinely regenerable or
# too large for git -- never source, never config.
# ---------------------------------------------------------------------------

# Build output -- regenerated by `flutter build`, ~50 MB and climbing.
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
*.class
*.log

# Gradle / Android local state. android/ ITSELF IS COMMITTED (it holds the
# patched manifest and minSdk), but these are machine-specific.
android/.gradle/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/
android/.kotlin/
.cxx/

# ML training artifacts. These are excluded for size, not secrecy:
#   ml/dataset/  -- RDD2022 plus local photos runs to several GB
#   ml/runs/     -- every epoch checkpoint; tens of GB over a full training run
# Recreate with: python ml/train_export.py prepare / train
ml/dataset/
ml/runs/
*.pt
*.onnx
__pycache__/
*.py[cod]
.venv/
venv/

# The exported model IS committed (assets/models/*.tflite, ~6-12 MB) so the
# repo is demo-ready without retraining.

# IDE / OS noise
.idea/
*.iml
*.iws
.DS_Store
Thumbs.db
ehthumbs.db
